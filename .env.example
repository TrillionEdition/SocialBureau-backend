NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/socialbureau
JWT_SECRET_KEY=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-host/api/campaigns/youtube/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=64-character-hex-encoded-32-byte-key
FRONTEND_URL=https://your-frontend-host
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM_EMAIL=verified-sender@your-domain.com
SUPPORT_EMAIL=team@socialbureau.in
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret